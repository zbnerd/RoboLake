# Synthetic local-development values only. Copy to .env to override them.
POSTGRES_DB=robolake
POSTGRES_USER=robolake
POSTGRES_PASSWORD=robolake-postgres-dev-only

MINIO_ROOT_USER=robolake-root
MINIO_ROOT_PASSWORD=robolake-minio-root-dev-only

ROBOLAKE_ENVIRONMENT=development
ROBOLAKE_DATABASE_URL=postgresql+psycopg://robolake:robolake-postgres-dev-only@localhost:15432/robolake
ROBOLAKE_S3_ENDPOINT_URL=http://localhost:19000
ROBOLAKE_S3_PUBLIC_ENDPOINT_URL=http://localhost:19000
ROBOLAKE_S3_ACCESS_KEY=robolake-api
ROBOLAKE_S3_SECRET_KEY=robolake-minio-api-dev-only
ROBOLAKE_S3_BUCKET=robolake-blobs
ROBOLAKE_S3_REGION=us-east-1
